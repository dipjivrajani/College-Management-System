@page "/login"
@using System.Security.Cryptography
@using System.Text
@{
    Layout = "_Layout";
    ViewData["Title"] = "Portal Login - Shree Sarswati Vishv Vidyalay Institute of Science";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

@functions {
    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string Role { get; set; } = "Student";

    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string UserId { get; set; } = "";

    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string Password { get; set; } = "";

    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string CaptchaInput { get; set; } = "";

    [Microsoft.AspNetCore.Mvc.BindProperty]
    public string CaptchaToken { get; set; } = "";

    public string CaptchaQuestion { get; set; } = "";
    public string? ErrorMessage { get; set; }

    // Server-side HMAC secret for resilient CAPTCHA verification (never revealed to client)
    private static readonly byte[] HmacSecret = Encoding.UTF8.GetBytes("CollegeManagement_Secure_Captcha_Salt_2026!");

@inject CollegeManagementSystem.Data.ApplicationDbContext DbContext

    public void OnGet()
    {
        GenerateNewCaptcha();
    }

    public void OnPost()
    {
        // 1. Validate CAPTCHA
        bool isCaptchaValid = CheckCaptchaAnswer(CaptchaInput, CaptchaToken);

        string enteredId = (UserId ?? "").Trim();
        string enteredPass = Password ?? "";

        // Always clear the CAPTCHA answer input field for next display
        CaptchaInput = "";
        // Always clear password field for security
        Password = "";

        if (!isCaptchaValid)
        {
            // If CAPTCHA is incorrect: Show "Invalid CAPTCHA." & generate a new CAPTCHA
            ErrorMessage = "Invalid CAPTCHA.";
            GenerateNewCaptcha();
            return;
        }

        // 2. Validate Credentials
        if (Role == "Admin")
        {
            var admin = DbContext.Admins.FirstOrDefault(a => a.Username.ToLower() == enteredId.ToLower() && a.Password == enteredPass);
            if (admin != null || (enteredId.ToLower() == "admin" && enteredPass == "admin123"))
            {
                HttpContext.Session.SetString("UserRole", "Admin");
                HttpContext.Session.SetString("UserName", admin?.FullName ?? "System Administrator");
                Response.Redirect("/Admin");
                return;
            }
        }
        else if (Role == "Teacher")
        {
            var teacher = DbContext.Teachers.FirstOrDefault(t => t.TeacherId.ToLower() == enteredId.ToLower() && t.Password == enteredPass);
            if (teacher != null)
            {
                HttpContext.Session.SetString("UserRole", "Teacher");
                HttpContext.Session.SetString("UserName", teacher.FullName);
                Response.Redirect("/");
                return;
            }
        }
        else if (Role == "Student")
        {
            var student = DbContext.Students.FirstOrDefault(s => s.StudentId.ToLower() == enteredId.ToLower() && s.Password == enteredPass);
            if (student != null)
            {
                HttpContext.Session.SetString("UserRole", "Student");
                HttpContext.Session.SetString("UserName", student.FullName);
                Response.Redirect("/");
                return;
            }
        }

        // Generic error if invalid: "Invalid ID or Password."
        ErrorMessage = "Invalid ID or Password.";
        GenerateNewCaptcha();
    }

    private void GenerateNewCaptcha()
    {
        var rnd = Random.Shared;
        string[] operations = { "+", "-", "*" };
        string op = operations[rnd.Next(operations.Length)];

        int num1 = 0;
        int num2 = 0;
        int answer = 0;

        if (op == "+")
        {
            num1 = rnd.Next(1, 21);
            num2 = rnd.Next(1, 21);
            answer = num1 + num2;
        }
        else if (op == "-")
        {
            num1 = rnd.Next(1, 21);
            num2 = rnd.Next(1, 21);
            // Ensure result is non-negative
            if (num1 < num2)
            {
                (num1, num2) = (num2, num1);
            }
            answer = num1 - num2;
        }
        else // op == "*"
        {
            num1 = rnd.Next(2, 11);
            num2 = rnd.Next(2, 10);
            answer = num1 * num2;
        }

        CaptchaQuestion = $"{num1} {op} {num2} = ?";

        // Store correct answer securely in server Session
        HttpContext.Session.SetInt32("ServerCaptchaAnswer", answer);

        // Also generate HMAC token as dual-protection fallback (prevents answer exposure)
        using var hmac = new HMACSHA256(HmacSecret);
        byte[] hash = hmac.ComputeHash(Encoding.UTF8.GetBytes(answer.ToString()));
        CaptchaToken = Convert.ToBase64String(hash);
    }

    private bool CheckCaptchaAnswer(string? input, string? token)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return false;
        }

        if (!int.TryParse(input.Trim(), out int enteredNumber))
        {
            return false;
        }

        // 1. Check Session first
        int? sessionAnswer = HttpContext.Session.GetInt32("ServerCaptchaAnswer");
        if (sessionAnswer.HasValue)
        {
            return enteredNumber == sessionAnswer.Value;
        }

        // 2. Fallback check using HMAC token
        if (!string.IsNullOrEmpty(token))
        {
            using var hmac = new HMACSHA256(HmacSecret);
            byte[] expectedHash = hmac.ComputeHash(Encoding.UTF8.GetBytes(enteredNumber.ToString()));
            string expectedToken = Convert.ToBase64String(expectedHash);
            return token == expectedToken;
        }

        return false;
    }
}

<div class="login-page-wrapper">
    <div class="login-card">
        <!-- Compact Header -->
        <div class="login-header">
            <div class="login-logo-badge">
                <span class="login-logo-emblem">🔬</span>
            </div>
            <h1 class="login-title">Welcome Back</h1>
            <p class="login-subtitle">College Management System</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="login-alert" role="alert">
                <span class="alert-icon">⚠️</span>
                <span>@ErrorMessage</span>
            </div>
        }

        <form method="post" class="login-form">
            <!-- Role Selection Tabs -->
            <div class="form-item">
                <label class="form-label">Login As:</label>
                <div class="role-tabs-row" role="tablist">
                    <button type="button" class="role-tab @(Role == "Admin" ? "active" : "")" data-role="Admin" role="tab" aria-selected="@(Role == "Admin" ? "true" : "false")">Admin</button>
                    <button type="button" class="role-tab @(Role == "Teacher" ? "active" : "")" data-role="Teacher" role="tab" aria-selected="@(Role == "Teacher" ? "true" : "false")">Teacher</button>
                    <button type="button" class="role-tab @(Role == "Student" ? "active" : "")" data-role="Student" role="tab" aria-selected="@(Role == "Student" ? "true" : "false")">Student</button>
                </div>
                <input type="hidden" id="selectedRole" name="Role" value="@Role" />
            </div>

            <!-- ID / Username -->
            <div class="form-item">
                <label id="idLabel" for="userId" class="form-label">Student ID</label>
                <input type="text" id="userId" name="UserId" value="@UserId" class="form-input" placeholder="Enter Student ID" required />
            </div>

            <!-- Password -->
            <div class="form-item">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="Password" class="form-input" placeholder="Enter password" required />
            </div>

            <!-- CAPTCHA (Horizontal Arrangement) -->
            <div class="form-item">
                <label for="captchaInput" class="form-label">CAPTCHA</label>
                <div class="captcha-row">
                    <div class="captcha-display-box" title="Solve math equation">
                        <span class="captcha-text">@CaptchaQuestion</span>
                        <a href="/login" class="captcha-refresh-btn" title="Refresh CAPTCHA question" aria-label="Refresh Captcha">↻</a>
                    </div>
                    <input type="text" id="captchaInput" name="CaptchaInput" class="form-input captcha-answer-input" placeholder="Answer" autocomplete="off" required />
                </div>
                <input type="hidden" name="CaptchaToken" value="@CaptchaToken" />
            </div>

            <!-- Login Button -->
            <button type="submit" class="btn-login-submit">Login</button>

            <!-- Forgot Password -->
            <div class="forgot-box">
                <a href="javascript:void(0)" id="forgotPasswordLink" class="forgot-link">Forgot Password?</a>
                <div id="forgotPasswordNotice" class="forgot-notice" style="display:none;">
                    Please contact the Admin to reset your password.
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var roleInput = document.getElementById('selectedRole');
        var idLabel = document.getElementById('idLabel');
        var userIdInput = document.getElementById('userId');
        var roleTabs = document.querySelectorAll('.role-tab');

        function setRole(role) {
            if (!roleInput || !idLabel || !userIdInput) return;
            roleInput.value = role;

            roleTabs.forEach(function (tab) {
                var isActive = tab.getAttribute('data-role') === role;
                tab.classList.toggle('active', isActive);
                tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            if (role === 'Admin') {
                idLabel.textContent = 'Admin ID';
                userIdInput.placeholder = 'Enter Admin ID';
            } else if (role === 'Teacher') {
                idLabel.textContent = 'Employee ID';
                userIdInput.placeholder = 'Enter Employee ID';
            } else {
                idLabel.textContent = 'Student ID';
                userIdInput.placeholder = 'Enter Student ID';
            }
        }

        roleTabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                var role = this.getAttribute('data-role');
                setRole(role);
            });
        });

        if (roleInput && roleInput.value) {
            setRole(roleInput.value);
        }

        var forgotLink = document.getElementById('forgotPasswordLink');
        var forgotNotice = document.getElementById('forgotPasswordNotice');
        if (forgotLink && forgotNotice) {
            forgotLink.addEventListener('click', function (e) {
                e.preventDefault();
                if (forgotNotice.style.display === 'none' || forgotNotice.style.display === '') {
                    forgotNotice.style.display = 'block';
                } else {
                    forgotNotice.style.display = 'none';
                }
            });
        }
    })();
</script>

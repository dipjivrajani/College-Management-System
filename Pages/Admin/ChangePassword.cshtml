@page "/Admin/ChangePassword"
@model CollegeManagementSystem.Pages.Admin.ChangePasswordModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Change Admin Password";
    ViewData["HeaderTitle"] = "Security Settings — Change Password";
}

<div class="admin-dashboard-wrapper" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-card-panel" style="padding: 24px;">
        <div class="panel-header-bar" style="margin-bottom: 18px; border-bottom: 1px solid var(--admin-border); padding-bottom: 12px;">
            <h3 class="panel-heading">🔒 Change Admin Account Password</h3>
        </div>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div style="background-color: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; padding: 12px 16px; border-radius: 6px; font-weight: 600; margin-bottom: 18px; font-size: 0.88rem;">
                ✅ @Model.StatusMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 6px; font-weight: 600; margin-bottom: 18px; font-size: 0.88rem;">
                ⚠️ @Model.ErrorMessage
            </div>
        }

        <p style="font-size: 0.84rem; color: var(--admin-muted); margin-bottom: 20px;">
            Update the system credentials for Admin account (<strong>@Model.Input.AdminUsername</strong>). New passwords are automatically salted and hashed using HMAC-SHA256 before being stored in the database.
        </p>

        <form method="post">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <!-- Current Password -->
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text); margin-bottom: 6px;">
                        Current Password <span style="color: #ef4444;">*</span>
                    </label>
                    <input asp-for="Input.CurrentPassword" type="password" class="form-input" style="width: 100%; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 12px; font-size: 0.9rem;" placeholder="Enter current admin password" required />
                    <span asp-validation-for="Input.CurrentPassword" style="font-size: 0.76rem; color: #dc2626;"></span>
                </div>

                <!-- New Password -->
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text); margin-bottom: 6px;">
                        New Password <span style="color: #ef4444;">*</span>
                    </label>
                    <input asp-for="Input.NewPassword" type="password" class="form-input" style="width: 100%; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 12px; font-size: 0.9rem;" placeholder="Minimum 6 characters" minlength="6" required />
                    <span asp-validation-for="Input.NewPassword" style="font-size: 0.76rem; color: #dc2626;"></span>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text); margin-bottom: 6px;">
                        Confirm New Password <span style="color: #ef4444;">*</span>
                    </label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-input" style="width: 100%; height: 38px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 12px; font-size: 0.9rem;" placeholder="Repeat new password" minlength="6" required />
                    <span asp-validation-for="Input.ConfirmPassword" style="font-size: 0.76rem; color: #dc2626;"></span>
                </div>

                <!-- Submit Button -->
                <div style="display: flex; gap: 10px; margin-top: 8px;">
                    <button type="submit" class="btn-admin-action primary" style="padding: 9px 20px; font-size: 0.88rem; font-weight: 700; border: none; cursor: pointer; border-radius: 6px;">
                        Update Admin Password
                    </button>
                    <a href="/Admin" class="btn-admin-action secondary" style="padding: 9px 16px; font-size: 0.88rem;">
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

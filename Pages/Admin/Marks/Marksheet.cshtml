@page "/Admin/Marks/Marksheet"
@model CollegeManagementSystem.Pages.AdminPortal.MarksAdmin.MarksheetModel
@{
    Layout = null;
    ViewData["Title"] = $"Marksheet - {Model.Student?.StudentId} ({Model.Semester})";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SSV Institute of Science</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #f1f5f9;
            color: #1e293b;
            padding: 24px;
        }
        .marksheet-page-wrapper {
            max-width: 860px;
            margin: 0 auto;
        }
        .print-actions-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }
        .btn-print {
            background-color: #102a43;
            color: #ffffff;
            border: none;
            padding: 9px 20px;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-print:hover { background-color: #243b53; }
        .btn-back {
            background-color: #ffffff;
            color: #334e68;
            border: 1px solid #cbd2d9;
            padding: 8px 16px;
            font-size: 0.88rem;
            font-weight: 600;
            border-radius: 6px;
            text-decoration: none;
        }
        .marksheet-document {
            background: #ffffff;
            border: 2px solid #334e68;
            padding: 36px 42px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            border-radius: 4px;
        }
        /* Institutional Header (PART 24 & 25) */
        .inst-header {
            text-align: center;
            border-bottom: 2px solid #102a43;
            padding-bottom: 16px;
            margin-bottom: 20px;
        }
        .inst-title {
            font-size: 1.55rem;
            font-weight: 800;
            color: #102a43;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .inst-sub {
            font-size: 1.1rem;
            font-weight: 600;
            color: #334e68;
            margin-top: 2px;
        }
        .inst-place {
            font-size: 0.88rem;
            color: #627d98;
            margin-top: 2px;
        }
        .doc-title-badge {
            display: inline-block;
            margin-top: 10px;
            background: #102a43;
            color: #ffffff;
            padding: 4px 20px;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            border-radius: 3px;
        }

        /* Student Metadata Table */
        .student-meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 22px;
            font-size: 0.88rem;
        }
        .student-meta-table td {
            padding: 5px 8px;
            vertical-align: top;
        }
        .meta-field-label {
            color: #627d98;
            font-weight: 600;
            width: 18%;
        }
        .meta-field-val {
            color: #102a43;
            font-weight: 700;
            width: 32%;
        }

        /* Subject Result Table */
        .subject-result-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.84rem;
            margin-bottom: 20px;
        }
        .subject-result-table th {
            background-color: #f0f4f8;
            color: #102a43;
            border: 1px solid #bcccdc;
            padding: 8px 10px;
            font-weight: 700;
            text-align: left;
        }
        .subject-result-table td {
            border: 1px solid #d9e2ec;
            padding: 7px 10px;
            color: #243b53;
        }
        .subject-result-table tr:nth-child(even) {
            background-color: #fafbfc;
        }

        /* Semester Summary Box */
        .result-summary-box {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border: 1px solid #bcccdc;
            background-color: #f8fafc;
            padding: 12px 16px;
            margin-bottom: 20px;
            gap: 12px;
            text-align: center;
        }
        .res-sum-lbl {
            font-size: 0.75rem;
            font-weight: 700;
            color: #627d98;
            text-transform: uppercase;
        }
        .res-sum-val {
            font-size: 1.15rem;
            font-weight: 800;
            color: #102a43;
            margin-top: 3px;
        }

        /* Overall Performance (PART 21 & 25) */
        .overall-perf-card {
            border: 1px solid #d9e2ec;
            border-radius: 4px;
            padding: 10px 14px;
            margin-bottom: 24px;
            font-size: 0.82rem;
            background: #ffffff;
        }
        .overall-perf-title {
            font-weight: 700;
            color: #102a43;
            margin-bottom: 6px;
            text-transform: uppercase;
            font-size: 0.78rem;
        }
        .overall-sem-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 6px;
            text-align: center;
        }
        .sem-score-cell {
            background: #f0f4f8;
            border: 1px solid #d9e2ec;
            padding: 4px;
            border-radius: 3px;
        }

        /* Signatures Footer (PART 25) */
        .signature-strip {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 48px;
            padding-top: 10px;
        }
        .sig-block {
            text-align: center;
            width: 28%;
        }
        .sig-line {
            border-top: 1px solid #486581;
            margin-bottom: 6px;
        }
        .sig-title {
            font-size: 0.8rem;
            font-weight: 600;
            color: #334e68;
        }

        .doc-footer-meta {
            margin-top: 24px;
            border-top: 1px dashed #cbd2d9;
            padding-top: 8px;
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: #829ab1;
        }

        /* PRINT STYLES */
        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .print-actions-bar {
                display: none !important;
            }
            .marksheet-document {
                border: none;
                box-shadow: none;
                padding: 0;
            }
            @@page {
                size: A4 portrait;
                margin: 1.2cm;
            }
        }
    </style>
</head>
<body>
    <div class="marksheet-page-wrapper">
        <!-- Print / Navigation Bar -->
        <div class="print-actions-bar">
            <a href="javascript:history.back()" class="btn-back">&larr; Back to Portal</a>
            <button type="button" class="btn-print" onclick="window.print()">
                <span>🖨️</span> Print / Save as PDF
            </button>
        </div>

        <!-- Official Marksheet Card -->
        <div class="marksheet-document">
            <!-- Header (PART 24 & 25) -->
            <div class="inst-header">
                <h1 class="inst-title">Shree Sarswati Vishv Vidyalay</h1>
                <h2 class="inst-sub">Institute of Science, Bhavnagar</h2>
                <p class="inst-place">Bhavnagar, Gujarat</p>
                <div class="doc-title-badge">Official Grade Sheet / Marksheet</div>
            </div>

            <!-- Student Information (PART 24) -->
            <table class="student-meta-table">
                <tr>
                    <td class="meta-field-label">Student Name:</td>
                    <td class="meta-field-val">@Model.Student?.FullName</td>
                    <td class="meta-field-label">Enrollment No:</td>
                    <td class="meta-field-val" style="font-family: monospace;">@Model.Student?.StudentId</td>
                </tr>
                <tr>
                    <td class="meta-field-label">Course:</td>
                    <td class="meta-field-val">@Model.Student?.Course</td>
                    <td class="meta-field-label">Department:</td>
                    <td class="meta-field-val">@Model.Student?.Department</td>
                </tr>
                <tr>
                    <td class="meta-field-label">Semester:</td>
                    <td class="meta-field-val">@Model.Semester</td>
                    <td class="meta-field-label">Admission Year:</td>
                    <td class="meta-field-val">@Model.Student?.AdmissionYear</td>
                </tr>
                <tr>
                    <td class="meta-field-label">Academic Year:</td>
                    <td class="meta-field-val">@(Model.ResultAttemptRecord?.AcademicYear ?? "2025-26")</td>
                    <td class="meta-field-label">Attempt:</td>
                    <td class="meta-field-val">Attempt @Model.Attempt</td>
                </tr>
            </table>

            <!-- Subject-wise Marks Table (PART 24 & 25) -->
            <table class="subject-result-table">
                <thead>
                    <tr>
                        <th style="width: 14%;">Subject Code</th>
                        <th style="width: 32%;">Subject Title</th>
                        <th style="width: 8%;">Credits</th>
                        <th style="width: 24%;">Components (Obt / Max)</th>
                        <th style="width: 10%;">Total</th>
                        <th style="width: 6%;">Grade</th>
                        <th style="width: 6%;">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SemesterResult?.Subjects != null)
                    {
                        @foreach (var s in Model.SemesterResult.Subjects)
                        {
                            <tr>
                                <td style="font-family: monospace; font-weight: 700;">@s.SubjectCode</td>
                                <td style="font-weight: 600;">@s.SubjectName</td>
                                <td style="text-align: center;">@s.Credits</td>
                                <td>
                                    @if (s.ConfiguredComponents != null && s.ConfiguredComponents.Count > 0)
                                    {
                                        <div style="font-size: 0.78rem; line-height: 1.4;">
                                            @foreach (var comp in s.ConfiguredComponents)
                                            {
                                                <span>@comp.ComponentType: <strong>@comp.ObtainedMarks</strong>/@comp.MaximumMarks</span><br />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span>--</span>
                                    }
                                </td>
                                <td><strong>@s.TotalObtained</strong> / @s.TotalMax</td>
                                <td style="text-align: center; font-weight: 700;">@s.Grade</td>
                                <td style="text-align: center; font-weight: 700; color: @(s.IsPass ? "#15803d" : "#b91c1c");">
                                    @(s.IsPass ? "PASS" : "FAIL")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Semester Summary (PART 25) -->
            <div class="result-summary-box">
                <div>
                    <div class="res-sum-lbl">Total Credits</div>
                    <div class="res-sum-val">@Model.SemesterResult?.TotalCredits</div>
                </div>
                <div>
                    <div class="res-sum-lbl">Marks Obtained</div>
                    <div class="res-sum-val">@Model.SemesterResult?.TotalObtainedMarks / @Model.SemesterResult?.TotalMaxMarks</div>
                </div>
                <div>
                    <div class="res-sum-lbl">Semester SGPA</div>
                    <div class="res-sum-val" style="color: #0369a1;">
                        @(Model.SemesterResult?.SGPA.HasValue == true ? Model.SemesterResult.SGPA.Value.ToString("0.00") : "--")
                    </div>
                </div>
                <div>
                    <div class="res-sum-lbl">Semester Result</div>
                    <div class="res-sum-val" style="color: @(Model.SemesterResult?.ResultStatus == "PASS" ? "#15803d" : (Model.SemesterResult?.ResultStatus == "FAIL" ? "#b91c1c" : "#627d98"));">
                        @Model.SemesterResult?.ResultStatus
                    </div>
                </div>
            </div>

            <!-- Cumulative Progress Across Completed Semesters (PART 21 & 25) -->
            @if (Model.OverallResult != null)
            {
                <div class="overall-perf-card">
                    <div class="overall-perf-title">Cumulative Academic Progress Summary</div>
                    <div class="overall-sem-grid">
                        @foreach (var semName in new[] { "Semester 1", "Semester 2", "Semester 3", "Semester 4", "Semester 5", "Semester 6" })
                        {
                            var sRes = Model.OverallResult.SemesterResults.ContainsKey(semName) ? Model.OverallResult.SemesterResults[semName] : null;
                            <div class="sem-score-cell">
                                <div style="font-weight: 600; font-size: 0.72rem; color: #486581;">@semName.Replace("Semester ", "Sem ")</div>
                                <div style="font-weight: 800; font-size: 0.88rem; color: #102a43;">
                                    @(sRes?.SGPA.HasValue == true ? sRes.SGPA.Value.ToString("0.00") : "--")
                                </div>
                                <div style="font-size: 0.68rem; font-weight: 700; color: @(sRes?.ResultStatus == "PASS" ? "#15803d" : (sRes?.ResultStatus == "FAIL" ? "#b91c1c" : "#627d98"));">
                                    @(sRes?.ResultStatus ?? "Pending")
                                </div>
                            </div>
                        }
                    </div>
                    <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #edf2f7; padding-top: 6px;">
                        <span>Completed Semesters: <strong>@Model.OverallResult.CompletedSemestersCount of 6</strong></span>
                        <span>Overall Cumulative CGPA: <strong style="font-size: 1rem; color: #0369a1;">@(Model.OverallResult.CGPA.HasValue ? Model.OverallResult.CGPA.Value.ToString("0.00") : "--")</strong></span>
                        <span>Program Result: <strong>@Model.OverallResult.OverallResult</strong></span>
                    </div>
                </div>
            }

            <!-- Institutional Signature & Stamp Section (PART 25: blank signature/stamp areas) -->
            <div class="signature-strip">
                <div class="sig-block">
                    <div class="sig-line"></div>
                    <div class="sig-title">Prepared By</div>
                </div>
                <div class="sig-block">
                    <div class="sig-line"></div>
                    <div class="sig-title">Checked By (HOD)</div>
                </div>
                <div class="sig-block">
                    <div class="sig-line"></div>
                    <div class="sig-title">Controller of Examinations / Principal</div>
                </div>
            </div>

            <!-- Footer Meta -->
            <div class="doc-footer-meta">
                <span>Date of Generation: @Model.GeneratedDate.ToString("dd-MMM-yyyy HH:mm")</span>
                <span>Exam Date: @(Model.ResultAttemptRecord?.ExamDate.HasValue == true ? Model.ResultAttemptRecord.ExamDate.Value.ToString("dd-MMM-yyyy") : DateTime.Today.ToString("dd-MMM-yyyy"))</span>
                <span>SSV Institute of Science, Bhavnagar</span>
            </div>
        </div>
    </div>
</body>
</html>
